 "facts": {
  "F1": {
   "kind": "fact",
   "text": "In Stripe API v1, retrying a POST with the same Idempotency-Key returns the saved status code and body of the first request, including 500 errors, and keys may be pruned once they are at least 24 hours old.",
   "sources": [
    "https://docs.stripe.com/api/idempotent_requests"
   ],
   "checked": "2026-11-17"
  },
  "F2": {
   "kind": "fact",
   "text": "Card payments can be authorized first and captured later; an online card authorization is usually valid for 7 days, after which the funds are released.",
   "sources": [
    "https://docs.stripe.com/payments/place-a-hold-on-a-payment-method"
   ],
   "checked": "2026-11-17"
  },
  "F3": {
   "kind": "fact",
   "text": "With a transactional outbox, the service writes the business change and the outgoing message in the same database transaction, and a separate relay publishes the message; the relay may publish a message more than once.",
   "sources": [
    "https://microservices.io/patterns/data/transactional-outbox.html"
   ]
  },
  "F4": {
   "kind": "fact",
   "text": "A saga is a coordinated sequence of local transactions; when a step fails, compensating transactions undo the changes of the steps already completed.",
   "sources": [
    "https://microservices.io/patterns/data/saga.html"
   ]
  },
  "F5": {
   "kind": "fact",
   "text": "Debezium's PostgreSQL connector captures row-level changes from PostgreSQL's logical decoding of the write-ahead log, and its outbox event router turns outbox rows into events.",
   "sources": [
    "https://debezium.io/documentation/reference/stable/connectors/postgresql.html",
    "https://debezium.io/documentation/reference/stable/transformations/outbox-event-router.html"
   ]
  },
  "F6": {
   "kind": "fact",
   "text": "In a double-entry ledger every transaction has at least two entries, and its total debits equal its total credits.",
   "sources": [
    "https://www.moderntreasury.com/journal/accounting-for-developers-part-i"
   ]
  },
  "F7": {
   "kind": "fact",
   "text": "Tokenizing card details in the browser sends them directly to the payment provider without touching the merchant's servers, which reduces but does not remove PCI DSS obligations.",
   "sources": [
    "https://docs.stripe.com/security/guide",
    "https://listings.pcisecuritystandards.org/documents/Tokenization_Guidelines_Info_Supplement.pdf"
   ]
  },
  "F8": {
   "kind": "fact",
   "text": "Stripe retries undelivered webhook events with exponential backoff for up to three days in live mode and does not guarantee event order.",
   "sources": [
    "https://docs.stripe.com/webhooks"
   ],
   "checked": "2026-11-17"
  },
  "F9": {
   "kind": "fact",
   "text": "Kafka consumers read a partition's records in exactly the order they were written; the guarantee is per partition.",
   "sources": [
    "https://kafka.apache.org/44/getting-started/introduction/"
   ]
  },
  "F10": {
   "kind": "fact",
   "text": "Stripe Radar scores each payment's fraud risk in real time and blocks high-risk payments by default before they reach the card network.",
   "sources": [
    "https://docs.stripe.com/radar/transaction-risk-prevention"
   ],
   "checked": "2026-11-17"
  },
  "D1": {
   "kind": "decision",
   "text": "Only the card vault, inside its own PCI zone, ever sees a card number; everything else handles tokens (F7).",
   "sources": []
  },
  "D2": {
   "kind": "decision",
   "text": "State changes leave the payment core only through the outbox, never by publishing directly (F3, F5).",
   "sources": []
  },
  "D3": {
   "kind": "decision",
   "text": "Events are keyed by payment id so one payment's events stay in order (F9); webhook consumers must still handle duplicates and reordering (F3, F8).",
   "sources": []
  },
  "D4": {
   "kind": "decision",
   "text": "Every money movement becomes balanced ledger entries (F6); a failed ledger write voids the authorization as a compensation (F4).",
   "sources": []
  },
  "D5": {
   "kind": "decision",
   "text": "Risk is scored before authorization, so blocked payments never reach the card network (F10).",
   "sources": []
  },
  "A1": {
   "kind": "assumption",
   "text": "The reconciler runs daily; the cadence is an assumption to confirm.",
   "sources": []
  },
  "A2": {
   "kind": "assumption",
   "text": "Stripe behaviour stands in for \"a typical card processor\"; other processors differ in limits.",
   "sources": []
  }
 },
