 "flows": [
  {
   "id": "card-payment",
   "label": "Card payment",
   "primary": true,
   "steps": [
    {
     "edge": "merchant->gateway",
     "text": "Merchant creates a payment with an idempotency key"
    },
    {
     "edge": "gateway->api",
     "text": "Authenticated and rate limited"
    },
    {
     "edge": "api->idem",
     "text": "A repeated key returns the first result"
    },
    {
     "edge": "api->saga",
     "text": "The payment runs as a saga"
    },
    {
     "edge": "saga->risk",
     "text": "Risk is scored before money moves"
    },
    {
     "edge": "saga->vault",
     "text": "Only the vault sees the card number"
    },
    {
     "edge": "vault->acquirer",
     "text": "Authorized with the card network"
    },
    {
     "edge": "saga->ledger",
     "text": "Balanced entries are posted"
    },
    {
     "edge": "saga->paydb",
     "text": "State and outbox commit together"
    },
    {
     "edge": "paydb->relay",
     "text": "The relay reads the outbox from the WAL"
    },
    {
     "edge": "relay->bus",
     "text": "payment.authorized is published"
    },
    {
     "edge": "bus->webhooks",
     "text": "The webhook sender consumes it"
    },
    {
     "edge": "webhooks->merchant",
     "text": "The merchant is notified"
    }
   ]
  },
  {
   "id": "retry-after-a-timeout",
   "label": "Retry after a timeout",
   "primary": false,
   "steps": [
    {
     "edge": "merchant->gateway",
     "text": "The merchant retries with the same key"
    },
    {
     "edge": "gateway->api",
     "text": "Same request reaches the API"
    },
    {
     "edge": "api->idem",
     "text": "The stored result is returned; nothing is charged twice"
    }
   ]
  },
  {
   "id": "reconciliation",
   "label": "Reconciliation",
   "primary": false,
   "steps": [
    {
     "edge": "acquirer->recon",
     "text": "Daily settlement file arrives"
    },
    {
     "edge": "recon->ledgerdb",
     "text": "Every settled amount is matched to ledger entries"
    }
   ]
  }
 ],
